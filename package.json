{
  "name": "formsey-monorepo",
  "description": "A new approach to create responsive forms using Web Components",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "demo"
  ],
  "scripts": {
    "start": "npm run dev",
    "dev": "npm run dev --workspace=demo",
    "build:demo": "npm run build --workspace=demo",
    "typecheck": "tsc --noEmit",
    "compile": "tsc",
    "watch": "tsc -w",
    "clean": "node scripts/clean.mjs",
    "compile:components": "npm run compile --prefix ../floreysoft-components",
    "rollup": "tsc && npm run compile:components && npm run rollup --workspaces --if-present",
    "test": "web-test-runner",
    "test:watch": "web-test-runner --watch",
    "pub": "npm login --scope=@formsey && npm run rollup && lerna publish",
    "forcePub": "npm run rollup && lerna publish --force-publish"
  },
  "devDependencies": {
    "@lit-labs/rollup-plugin-minify-html-literals": "^0.2.0",
    "@open-wc/testing": "^5.0.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "@types/mocha": "^10.0.10",
    "@web/dev-server-esbuild": "^2.0.1",
    "@web/test-runner": "^1.0.1",
    "lerna": "^10.1.1",
    "lit": "^3.3.3",
    "rollup": "^4.68.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "overrides": {
    "@floreysoft/ace": "file:../floreysoft-components/packages/floreysoft-ace",
    "@floreysoft/icon": "file:../floreysoft-components/packages/floreysoft-icon",
    "@floreysoft/splitter": "file:../floreysoft-components/packages/floreysoft-splitter",
    "@floreysoft/theme": "file:../floreysoft-components/packages/floreysoft-theme",
    "@floreysoft/utils": "file:../floreysoft-components/packages/floreysoft-utils"
  },
  "contributors": [
    {
      "name": "Daniel Florey",
      "url": "https://twitter.com/danielflorey",
      "img": "https://avatars0.githubusercontent.com/u/2938750?s=460&v=4"
    },
    {
      "name": "Oliver Zeigermann",
      "url": "https://github.com/DJCordhose",
      "img": "https://avatars0.githubusercontent.com/u/394409?s=460&v=4"
    }
  ]
}
