{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "customConditions": ["@floreysoft/source"],
    "lib": ["es2023", "dom", "dom.iterable"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "inlineSources": true,
    "strict": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,
    "types": ["vite/client"],
    "pretty": true,
    "skipLibCheck": true
  },
  "include": [
    "packages/**/*.ts",
    "demo/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules",
    "**/*.d.ts",
    "**/*.spec.ts"
  ]
}
